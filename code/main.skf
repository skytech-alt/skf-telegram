// ============================================
//   skf-telegram — Telegram Bot API
//   от SkyMonder
// ============================================

// Подтягиваем пакеты-помощники
пусть http = подтянуть "skf-http"
пусть json = подтянуть "skf-json"


// --------------------------------------------
//   БАЗОВЫЙ КЛИЕНТ
// --------------------------------------------

функция создать_бота(токен) {
    // Создаёт объект-бота с указанным токеном.
    // Возвращает словарь с настройками и методами.
    пусть бот = {
        "токен": токен,
        "базовый_адрес": "https://api.telegram.org/bot" + токен,
        "последний_update_id": 0,
        "обработчики": {}
    }
    вернуть бот
}

функция _запрос(бот, метод, данные) {
    // Внутренняя функция: выполняет запрос к Telegram API
    пусть адрес = бот["базовый_адрес"] + "/" + метод
    
    попробовать {
        пусть ответ = http.отправить_json(адрес, данные)
        
        если (http.ок?(ответ) == ложь) {
            бросить "Telegram API вернул код " + http.код(ответ)
        }
        
        пусть результат = http.json(ответ)
        
        если (результат["ok"] == ложь) {
            бросить "Telegram ошибка: " + результат["description"]
        }
        
        вернуть результат["result"]
    } поймать (ошибка) {
        бросить "Ошибка запроса к Telegram: " + ошибка
    }
}


// --------------------------------------------
//   ОТПРАВКА СООБЩЕНИЙ
// --------------------------------------------

функция отправить_сообщение(бот, чат_id, текст, клавиатура) {
    // Отправляет текстовое сообщение в указанный чат.
    // клавиатура — необязательный параметр (объект reply_markup).
    пусть данные = {
        "chat_id": чат_id,
        "text": текст,
        "parse_mode": "HTML"
    }
    
    если (клавиатура != ничего) {
        данные["reply_markup"] = клавиатура
    }
    
    вернуть _запрос(бот, "sendMessage", данные)
}

функция ответить(бот, сообщение, текст) {
    // Отправляет сообщение в ответ на входящее.
    // message — объект из update.
    пусть чат_id = сообщение["chat"]["id"]
    вернуть отправить_сообщение(бот, чат_id, текст, ничего)
}

функция отправить_фото(бот, чат_id, путь_или_url, подпись) {
    // Отправляет фото по URL или file_id.
    пусть данные = {
        "chat_id": чат_id,
        "photo": путь_или_url
    }
    
    если (подпись != ничего) {
        данные["caption"] = подпись
    }
    
    вернуть _запрос(бот, "sendPhoto", данные)
}

функция отправить_документ(бот, чат_id, путь_или_url) {
    // Отправляет документ.
    пусть данные = {
        "chat_id": чат_id,
        "document": путь_или_url
    }
    вернуть _запрос(бот, "sendDocument", данные)
}

функция отправить_локацию(бот, чат_id, широта, долгота) {
    // Отправляет геолокацию.
    пусть данные = {
        "chat_id": чат_id,
        "latitude": широта,
        "longitude": долгота
    }
    вернуть _запрос(бот, "sendLocation", данные)
}

функция отредактировать_сообщение(бот, чат_id, message_id, новый_текст) {
    // Редактирует отправленное сообщение.
    пусть данные = {
        "chat_id": чат_id,
        "message_id": message_id,
        "text": новый_текст,
        "parse_mode": "HTML"
    }
    вернуть _запрос(бот, "editMessageText", данные)
}

функция удалить_сообщение(бот, чат_id, message_id) {
    // Удаляет сообщение.
    пусть данные = {
        "chat_id": чат_id,
        "message_id": message_id
    }
    вернуть _запрос(бот, "deleteMessage", данные)
}


// --------------------------------------------
//   КЛАВИАТУРЫ
// --------------------------------------------

функция клавиатура_ответов(кнопки, под_сообщением) {
    // Создаёт reply-клавиатуру (кнопки внизу экрана).
    // кнопки — список строк или список списков строк.
    если (под_сообщением == ничего) {
        под_сообщением = ложь
    }
    
    пусть строки = []
    для (строка в кнопки) {
        если (тип(строка) == "список") {
            пусть ряд = []
            для (кнопка в строка) {
                ряд.добавить({"text": кнопка})
            }
            строки.добавить(ряд)
        } иначе {
            строки.добавить([{"text": строка}])
        }
    }
    
    вернуть {
        "keyboard": строки,
        "resize_keyboard": под_сообщением,
        "one_time_keyboard": ложь
    }
}

функция inline_клавиатура(кнопки) {
    // Создаёт inline-клавиатуру (кнопки под сообщением).
    // кнопки — список списков объектов {"текст": ..., "данные": ...}.
    пусть строки = []
    для (строка в кнопки) {
        пусть ряд = []
        для (кнопка в строка) {
            пусть к = {"text": кнопка["текст"]}
            
            если (кнопка.содержит("url")) {
                к["url"] = кнопка["url"]
            } иначе если (кнопка.содержит("данные")) {
                к["callback_data"] = кнопка["данные"]
            }
            
            ряд.добавить(к)
        }
        строки.добавить(ряд)
    }
    
    вернуть {
        "inline_keyboard": строки
    }
}

функция убрать_клавиатуру() {
    // Убирает reply-клавиатуру.
    вернуть {
        "remove_keyboard": истина
    }
}


// --------------------------------------------
//   ПОЛУЧЕНИЕ ОБНОВЛЕНИЙ
// --------------------------------------------

функция получить_обновления(бот, таймаут) {
    // Получает новые обновления через long polling.
    // Возвращает список update-объектов.
    если (таймаут == ничего) {
        таймаут = 30
    }
    
    пусть данные = {
        "offset": бот["последний_update_id"] + 1,
        "timeout": таймаут,
        "allowed_updates": ["message", "callback_query"]
    }
    
    пусть обновления = _запрос(бот, "getUpdates", данные)
    
    // Обновляем последний update_id
    для (обновление в обновления) {
        если (обновление["update_id"] > бот["последний_update_id"]) {
            бот["последний_update_id"] = обновление["update_id"]
        }
    }
    
    вернуть обновления
}

функция запустить_бота(бот, функция_обработки, таймаут) {
    // Запускает бесконечный цикл обработки обновлений.
    // функция_обработки(бот, обновление) вызывается для каждого update.
    если (таймаут == ничего) {
        таймаут = 30
    }
    
    лог("🤖 Бот запущен. Нажми Ctrl+C для остановки.")
    
    пока (истина) {
        попробовать {
            пусть обновления = получить_обновления(бот, таймаут)
            
            для (обновление в обновления) {
                попробовать {
                    функция_обработки(бот, обновление)
                } поймать (ошибка) {
                    лог("⚠️ Ошибка в обработчике: " + ошибка)
                }
            }
        } поймать (ошибка) {
            лог("❌ Ошибка получения обновлений: " + ошибка)
            // Небольшая пауза перед повтором
            подключить_питон("time")
            time.sleep(3)
        }
    }
}


// --------------------------------------------
//   ПОЛЕЗНЫЕ УТИЛИТЫ
// --------------------------------------------

функция текст_сообщения(обновление) {
    // Извлекает текст из message-обновления.
    если (обновление.содержит("message")) {
        если (обновление["message"].содержит("text")) {
            вернуть обновление["message"]["text"]
        }
    }
    вернуть ничего
}

функция чат_id(обновление) {
    // Извлекает chat_id из обновления.
    если (обновление.содержит("message")) {
        вернуть обновление["message"]["chat"]["id"]
    } иначе если (обновление.содержит("callback_query")) {
        вернуть обновление["callback_query"]["message"]["chat"]["id"]
    }
    вернуть ничего
}

функция от_кого(обновление) {
    // Извлекает информацию об отправителе.
    если (обновление.содержит("message")) {
        вернуть обновление["message"]["from"]
    } иначе если (обновление.содержит("callback_query")) {
        вернуть обновление["callback_query"]["from"]
    }
    вернуть ничего
}

функция это_команда?(обновление, команда) {
    // Проверяет, является ли сообщение указанной командой (например, "/start").
    пусть текст = текст_сообщения(обновление)
    если (текст == ничего) {
        вернуть ложь
    }
    вернуть текст == команда или текст.начинается_с(команда + " ")
}

функция ответить_на_callback(бот, callback_id, текст) {
    // Отвечает на нажатие inline-кнопки.
    пусть данные = {
        "callback_query_id": callback_id,
        "text": текст,
        "show_alert": ложь
    }
    вернуть _запрос(бот, "answerCallbackQuery", данные)
}

функция получить_меня(бот) {
    // Возвращает информацию о боте.
    вернуть _запрос(бот, "getMe", {})
}
